rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Applications are written exclusively by the server (Admin SDK), which
    // bypasses these rules. Clients may only READ their own applications,
    // matched on the lowercased email stored on each document.
    match /applications/{applicationId} {
      allow read: if request.auth != null
        && (
          request.auth.token.admin == true
          || (
            request.auth.token.email != null
            && resource.data.email == request.auth.token.email.lower()
          )
        );

      // No client-side writes. The /api routes (Admin SDK) are the only writers.
      allow create, update, delete: if false;
    }

    // Everything else is closed by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
